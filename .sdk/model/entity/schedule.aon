# Entity: schedule

main: kit: entity: schedule: {

  alias: field: {}

  fields: [
    {
      name: "awayTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "competition"
      req: false
      short: "Name of the competition or league"
      type: "`$STRING`"
    }
    {
      name: "homeTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "matchId"
      req: false
      short: "Unique identifier for the match"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "scheduledTime"
      req: false
      short: "Scheduled start time of the match"
      type: "`$STRING`"
    }
    {
      name: "sport"
      req: false
      short: "Type of sport"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Match status"
      type: "`$STRING`"
    }
    {
      name: "venue"
      req: false
      short: "Venue where the match will be played"
      type: "`$STRING`"
    }
  ]

  name: "schedule"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "date"
                orig: "date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "sport"
                orig: "sport"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "team"
                orig: "team"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/upcoming-games"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "upcoming-games"
            }
          ]
          select: {
            exist: [
              "date"
              "sport"
              "team"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.matches`"
          }
        }
      ]
    }
  }



}
