# Entity: score

main: kit: entity: score: {

  alias: field: {}

  fields: [
    {
      name: "awayTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "competition"
      req: false
      short: "Name of the competition or league"
      type: "`$STRING`"
    }
    {
      name: "homeTeam"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "matchDate"
      req: false
      short: "Date and time when the match took place"
      type: "`$STRING`"
    }
    {
      name: "matchId"
      req: false
      short: "Unique identifier for the match"
      type: "`$STRING`"
    }
    {
      name: "minute"
      req: false
      short: "Current minute of the match"
      type: "`$STRING`"
    }
    {
      name: "sport"
      req: false
      short: "Type of sport"
      type: "`$STRING`"
    }
    {
      name: "startTime"
      req: false
      short: "Match start time"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Match status"
      type: "`$STRING`"
    }
  ]

  name: "score"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "date"
                orig: "date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "sport"
                orig: "sport"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "team"
                orig: "team"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/final-results"
          parts: [
            "api"
            "final-results"
          ]
          select: {
            exist: [
              "date"
              "sport"
              "team"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.matches`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "sport"
                orig: "sport"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "team"
                orig: "team"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/live-scores"
          parts: [
            "api"
            "live-scores"
          ]
          select: {
            exist: [
              "sport"
              "team"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.matches`"
          }
        }
      ]
    }
  }



}
